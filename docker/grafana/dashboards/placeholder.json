        {
          "refId": "A",
          "expr": "(sum(increase(ktor_http_server_requests_seconds_count{status=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(ktor_http_server_requests_seconds_count[$__range])), 1e-9)",
